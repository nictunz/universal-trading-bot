# Runtime
BOT_MODE=PAPER
SYMBOL=BTC/USDT
TIMEFRAME=5m

# Optional symbol list for dashboard / scanner
SYMBOLS=BTC/USDT,ETH/USDT

# Strategy
VOLUME_LOOKBACK=70
VOLUME_BREAK_MULTIPLIER=8
USE_FOUR_CRYPTO_EXCHANGES=true
MIN_ONE_BAR_VOL=0.1
MAX_ONE_BAR_VOL=1.0
VOLATILITY_BARS=288
TP_VOL_MULTIPLIER=0.4
SL_VOL_MULTIPLIER=0.8
MIN_TP_PERCENT=0.20
MAX_TP_PERCENT=2.00
MIN_SL_PERCENT=0.30
MAX_SL_PERCENT=2.00
USE_NBAR_VOLATILITY_BLOCK=true
NBAR_VOLATILITY_BARS=200
MAX_NBAR_VOLATILITY=5.0
USE_ADX_FILTER=false
ADX_LENGTH=14
ADX_MIN=20
ADX_MAX=100
USE_RSI_FILTER=true
RSI_LENGTH=8
RSI_OVERSOLD_MIN=10
RSI_OVERSOLD_MAX=25
RSI_OVERBOUGHT_MIN=75
RSI_OVERBOUGHT_MAX=90
ALLOW_LONG=true
ALLOW_SHORT=true
MAX_PYRAMIDING=2
COOLDOWN_BARS=6
REENTRY_BARS=6
USE_START_DATE=true
START_DATE=2024-01-01T00:00:00+00:00
BLOCK_WEEKEND=false
EXCLUDED_HOURS=00

# Position sizing
ORDER_PERCENT_OF_EQUITY=5
INITIAL_CAPITAL=1000000

# Exchange credentials - leave blank for paper/backtest
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Stock / ETF provider placeholders
STOCK_DATA_PROVIDER=yfinance
BROKER_API_KEY=
BROKER_API_SECRET=

# Storage / dashboard
DATABASE_URL=sqlite:///data/universal_bot.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
