# Runtime
BOT_MODE=PAPER
EXCHANGE=bitget
ASSET_CLASS=crypto
SYMBOL=BTC/USDT:USDT
TIMEFRAME=15m
POLL_SECONDS=10

# Optional symbol list for dashboard / scanner
# Crypto examples: BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
# Stock/ETF examples when ASSET_CLASS=stock/etf: AAPL,NVDA,005930.KS,SPY,QQQ
SYMBOLS=BTC/USDT:USDT

# Strategy
VOLUME_LOOKBACK=40
VOLUME_BREAK_MULTIPLIER=6.4
USE_FOUR_CRYPTO_EXCHANGES=true
MIN_ONE_BAR_VOL=0.1
MAX_ONE_BAR_VOL=3.6
VOLATILITY_BARS=36
TP_VOL_MULTIPLIER=3.8
SL_VOL_MULTIPLIER=1.0
MIN_TP_PERCENT=0.3
MAX_TP_PERCENT=2.1
MIN_SL_PERCENT=0.3
MAX_SL_PERCENT=1.9
USE_NBAR_VOLATILITY_BLOCK=true
NBAR_VOLATILITY_BARS=200
MAX_NBAR_VOLATILITY=6.3
USE_ADX_FILTER=false
ADX_LENGTH=7
ADX_MIN=11.6
ADX_MAX=80.5
USE_RSI_FILTER=true
RSI_LENGTH=10
RSI_OVERSOLD_MIN=20.0
RSI_OVERSOLD_MAX=42.0
RSI_OVERBOUGHT_MIN=65.6
RSI_OVERBOUGHT_MAX=74.7
ALLOW_LONG=true
ALLOW_SHORT=true
# One entry only.
MAX_PYRAMIDING=1
COOLDOWN_BARS=3
REENTRY_BARS=5
USE_START_DATE=true
START_DATE=2024-01-01T00:00:00+00:00
BLOCK_WEEKEND=false
EXCLUDED_HOURS=

# Position sizing / historical execution assumptions
# These remain for PAPER/BACKTEST. Elite LIVE uses LIVE_ENTRY_MULTIPLIER below.
ORDER_PERCENT_OF_EQUITY=860
INITIAL_CAPITAL=1000
BACKTEST_FEE_PERCENT=0.02
BACKTEST_SLIPPAGE_PERCENT=0.01

# Realtime crypto market-data routing
CRYPTO_VOLUME_PROVIDER=none
CRYPTO_VOLUME_FALLBACK_EXCHANGES=binance,bybit
ALLOW_COMMUNITY_MARKET_DATA_LIVE=false
COINAPI_API_KEY=

# LIVE safety / Bitget
# Keep PAPER until preflight reports ready=true.
BITGET_EXECUTION_PROFILE=elite
# auto = probe UTA v3 first, otherwise Classic v2. After migration you may pin uta-v3.
BITGET_API_FAMILY=auto
LEVERAGE=15
MARGIN_MODE=crossed
LIVE_REQUIRE_ONE_WAY_MODE=true
REQUIRE_EXCHANGE_PROTECTION=true
RECONCILIATION_INTERVAL_SECONDS=10
STALE_DATA_SECONDS=600
MAX_CONSECUTIVE_API_ERRORS=3
# Elite LIVE follows 진입_비중_pct=860: current available USDT x 8.6.
# LEVERAGE=15 is the exchange leverage ceiling, not the order-size multiplier.
LIVE_ENTRY_MULTIPLIER=8.6
# One entry only.
LIVE_MAX_ENTRIES_PER_POSITION=1
# Absolute guard: never exceed 15x the available-USDT basis.
LIVE_MAX_TOTAL_MULTIPLIER=15
# Retained for standard/non-Elite LIVE routing only.
LIVE_MAX_POSITION_NOTIONAL_PERCENT=10
BITGET_ELITE_REQUEST_TIMEOUT=8

# Discord notifications
# Keep the real webhook only in the server .env; never commit it.
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_TIMEOUT=5

# Bitget normal/standard API
# Reserved for funding/spot/normal-account operations such as future transfer tools.
BITGET_STANDARD_API_KEY=
BITGET_STANDARD_API_SECRET=
BITGET_STANDARD_API_PASSPHRASE=

# Bitget LIVE credentials. Existing v2 keys can be reused after UTA migration
# when the key has the required UTA management/trade permissions.
BITGET_ELITE_API_KEY=
BITGET_ELITE_API_SECRET=
BITGET_ELITE_API_PASSPHRASE=

# Legacy Bitget names retained only for backwards compatibility.
# New deployments should leave these blank.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Other exchange credentials - leave blank unless specifically needed
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_API_PASSPHRASE=

# Stock / ETF market data
STOCK_DATA_PROVIDER=yfinance
BROKER_API_KEY=
BROKER_API_SECRET=

# Storage
DATABASE_URL=sqlite:///data/universal_bot.db

# Dashboard network
# FastAPI stays private on the server; nginx exposes http://34.132.172.40 on port 80.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_PUBLIC_URL=http://34.132.172.40

# Dashboard administrator authentication
# Public dashboard/read-only APIs stay open. Strategy changes, write-backtests,
# and LIVE control APIs require login. Until credentials below are filled in,
# protected pages fail closed instead of becoming public.
# Never commit real values. Put them only in the server's .env file.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=12
# Keep false while using plain HTTP. Change to true after HTTPS is configured.
DASHBOARD_COOKIE_SECURE=false
