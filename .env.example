# Runtime
BOT_MODE=PAPER
EXCHANGE=bitget
ASSET_CLASS=crypto
SYMBOL=BTC/USDT:USDT
TIMEFRAME=5m
POLL_SECONDS=10

# Optional symbol list for dashboard / scanner
# Crypto examples: BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
# Stock/ETF examples when ASSET_CLASS=stock/etf: AAPL,NVDA,005930.KS,SPY,QQQ
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT

# Strategy
VOLUME_LOOKBACK=70
VOLUME_BREAK_MULTIPLIER=8
USE_FOUR_CRYPTO_EXCHANGES=true
MIN_ONE_BAR_VOL=0.1
MAX_ONE_BAR_VOL=1.0
VOLATILITY_BARS=288
TP_VOL_MULTIPLIER=0.4
SL_VOL_MULTIPLIER=0.8
MIN_TP_PERCENT=0.20
MAX_TP_PERCENT=2.00
MIN_SL_PERCENT=0.30
MAX_SL_PERCENT=2.00
USE_NBAR_VOLATILITY_BLOCK=true
NBAR_VOLATILITY_BARS=200
MAX_NBAR_VOLATILITY=5.0
USE_ADX_FILTER=false
ADX_LENGTH=14
ADX_MIN=20
ADX_MAX=100
USE_RSI_FILTER=true
RSI_LENGTH=8
RSI_OVERSOLD_MIN=10
RSI_OVERSOLD_MAX=25
RSI_OVERBOUGHT_MIN=75
RSI_OVERBOUGHT_MAX=90
ALLOW_LONG=true
ALLOW_SHORT=true
MAX_PYRAMIDING=2
COOLDOWN_BARS=6
REENTRY_BARS=6
USE_START_DATE=true
START_DATE=2024-01-01T00:00:00+00:00
BLOCK_WEEKEND=false
EXCLUDED_HOURS=00

# Position sizing / historical execution assumptions
ORDER_PERCENT_OF_EQUITY=5
INITIAL_CAPITAL=1000000
BACKTEST_FEE_PERCENT=0.06
BACKTEST_SLIPPAGE_PERCENT=0.02

# Crypto market-data routing
# Direct exchange public APIs are preferred. On approved provider accounts the
# listed venues can fall back to CoinAPI market data if direct public access is
# unavailable from the server region. Never place a provider key in GitHub.
CRYPTO_VOLUME_PROVIDER=coinapi
CRYPTO_VOLUME_FALLBACK_EXCHANGES=binance,bybit
COINAPI_API_KEY=

# LIVE safety (LIVE remains disabled unless BOT_MODE=LIVE is explicitly set)
LEVERAGE=50
MARGIN_MODE=cross
REQUIRE_EXCHANGE_PROTECTION=true
RECONCILIATION_INTERVAL_SECONDS=10
STALE_DATA_SECONDS=600
MAX_CONSECUTIVE_API_ERRORS=3
LIVE_MAX_POSITION_NOTIONAL_PERCENT=10
LIVE_REQUIRE_ONE_WAY_MODE=true

# Exchange credentials - leave blank for paper/backtest
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_API_PASSPHRASE=

# Stock / ETF market data. Backtest/PAPER uses yfinance; actual stock/ETF order
# execution remains disabled until a separate broker adapter is configured.
STOCK_DATA_PROVIDER=yfinance
BROKER_API_KEY=
BROKER_API_SECRET=

# Storage / dashboard
DATABASE_URL=sqlite:///data/universal_bot.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
